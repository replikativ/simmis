{
  "name": "simmis",
  "scripts": {
    "test:browser": "shadow-cljs -A:shadow:browser-tests compile browser-tests && node scripts/test_browser.mjs",
    "dev": "shadow-cljs -A:shadow watch app & npm run styles-dev",
    "release": "shadow-cljs -A:shadow release app && npm run styles-release",
    "build:css": "node scripts/copy_math_assets.mjs && cp src/is/simm/core.css public/main.css && lightningcss --bundle public/main.css -o public/main.css",
    "styles-dev": "onchange -i src/is/simm/core.css -- npm run build:css",
    "styles-release": "node scripts/copy_math_assets.mjs && cp src/is/simm/core.css public/main.css && lightningcss --minify --bundle public/main.css -o public/main.css"
  },
  "devDependencies": {
    "lightningcss-cli": "^1.30.1",
    "onchange": "^7.1.0",
    "shadow-cljs": "2.28.21"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@js-joda/core": "3.2.0",
    "@tiptap/core": "^3.6.6",
    "@tiptap/extension-link": "^3.6.6",
    "@tiptap/extension-placeholder": "^3.6.6",
    "@tiptap/extension-table": "3.27.3",
    "@tiptap/pm": "^3.6.6",
    "@tiptap/starter-kit": "^3.6.6",
    "@tiptap/suggestion": "^3.6.6",
    "dompurify": "3.4.17",
    "highlight.js": "^11.11.1",
    "katex": "0.19.0",
    "marked": "^17.0.4",
    "marked-highlight": "^2.2.3",
    "tippy.js": "^6.3.7"
  },
  "allowScripts": {
    "lightningcss-cli@1.32.0": true
  },
  "license": "MIT"
}
