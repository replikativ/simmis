;; Copy to `config.local.edn` (gitignored) and edit.
;;
;; Everything here is OPTIONAL except `:alpha-users` — without at least one
;; account there is no way to log in, because simmis has no self-registration.
;;
;; Secrets belong in this file or in the environment, never in the repo.

{;; ---------------------------------------------------------------------------
 ;; Accounts. Seeded at boot; existing accounts are never modified, so changing
 ;; a password here does NOT change it in the database — delete the store or
 ;; change it in the UI.
 ;;
 ;; :role — :admin unlocks the admin panel (users, models, budgets). Anything
 ;; else is an ordinary member.
 :alpha-users
 [{:email "you@example.com"
   :name "Your Name"
   :handle "you"                ;; what @mentions resolve to; must be unique
   :password "change-me"
   :role :admin}]

 ;; ---------------------------------------------------------------------------
 ;; Telegram mirror (optional). A room can be mirrored into a Telegram chat;
 ;; messages flow both ways and agents answer in either place.
 ;;
 ;; The token can also come from TELEGRAM_BOT_TOKEN.
 ;; :allowed-users gates who may talk to the bot — numeric ids or "@handle".
 ;; An empty or missing allowlist refuses EVERY sender (dvergr authenticates a
 ;; Telegram sender only when the allowlist lists it). Numeric ids are safer:
 ;; a handle can be changed and then taken by someone else.
 #_:telegram #_{:token "123456:ABC-DEF..."
                :allowed-users #{123456789 "@your-handle"}}

 ;; ---------------------------------------------------------------------------
 ;; External identity providers (optional). Tokens from these issuers are
 ;; accepted alongside simmis's own, on the same socket — this is how WorkOS,
 ;; Clerk, Auth0 or Google sign-in attach. `:jwks-url` keys rotate and are
 ;; fetched on demand; `:public-key` pins a static one instead.
 #_:oidc-issuers #_[{:iss "https://your-tenant.authkit.app"
                     :jwks-url "https://your-tenant.authkit.app/oauth2/jwks"
                     :alg :RS256}]

 ;; ---------------------------------------------------------------------------
 ;; Keys agents may USE (optional). An agent's sandbox never sees the host
 ;; environment: `env/get` resolves only what is granted here, so a key that is
 ;; set in the environment but not listed reads as unset — web search answers
 ;; "BRAVE_API_KEY … not set" although the server has it. A listed secret
 ;; reaches the agent as an opaque placeholder; the http egress swaps in the
 ;; real value only for `:allowed-domains`, in the listed locations.
 ;; `:env` names the variable the value comes from; `:config-path` points at a
 ;; value elsewhere in this file instead. Restart, or rejoin the agent, after
 ;; changing this.
 #_:secrets #_[{:name "BRAVE_API_KEY" :env "BRAVE_API_KEY"
                :allowed-domains ["https://api.search.brave.com"]
                :allowed-locations [:header :query]
                :header-names ["X-Subscription-Token"]}]}

;; -----------------------------------------------------------------------------
;; Environment variables (NOT this file)
;;
;;   SIMMIS_JWT_SECRET   Signing secret for simmis's own tokens. Unset in
;;                       development: a secret is generated once and persisted
;;                       to .dvergr/jwt-secret so sessions survive restarts.
;;                       SET IT IN PRODUCTION — otherwise the secret lives in a
;;                       file next to the data it protects.
;;
;;   SIMMIS_DEV_AUTH     Set to "true" ONLY on a throwaway instance. It enables
;;                       POST /auth/dev, which mints a valid token for ANY email
;;                       and creates the account if missing. There is no password
;;                       check. simmis warns loudly on every boot while it is on.
;;
;;   SIMMIS_ALLOW_SELF_REGISTRATION
;;                       Set to "true" to enable POST /auth/register, which lets
;;                       anyone who can reach the server create an account. OFF by
;;                       default: accounts come from :alpha-users below, and an
;;                       account is what every :authenticated RPC checks for.
;;                       simmis warns on every boot while it is on.
;;
;;   FIREWORKS_API_KEY   LLM providers. A provider is registered at boot only
;;   OPENAI_API_KEY      if its key is present. The explicit default (only when
;;   ANTHROPIC_API_KEY   nobody chose a model) is the Fireworks GLM family, so
;;                       FIREWORKS_API_KEY is the least-effort option. A missing,
;;                       withdrawn, unsupported, or unreachable choice is never
;;                       replaced with that default. Set several; each agent
;;                       picks its own model, and the provider follows from it.
;;                       Keys are provider-scoped: OpenAI never supplies a
;;                       Fireworks credential, or vice versa. Restart after
;;                       adding or changing a provider credential. A key the
;;                       provider REJECTS reads as "Credential rejected" on the
;;                       affected rows: that is a key to replace, not an outage
;;                       to wait out.
;;
;;                       A key is permission to ASK, not the answer. Every one
;;                       of these providers is asked which models the ACCOUNT
;;                       may run, each over its own documented API — Anthropic
;;                       over its native paginated Models API, not an
;;                       OpenAI-compatible one. So a valid key whose account has
;;                       no access to a given model reads "Unavailable to
;;                       account" rather than offering a choice that would fail
;;                       at the first turn.
;;
;;   OPENAI_BASE_URL     Where OPENAI_API_KEY points. UNSET means OpenAI itself
;;                       (https://api.openai.com/v1) — the gpt-5.6 / gpt-5.5
;;                       models. Set it to reach any other OpenAI-compatible
;;                       endpoint, including a local one, with that same key.
;;                       It never changes Fireworks' base. A supplied base is
;;                       treated as compatible, not as native OpenAI behavior.
;;
;;   SIMMIS_JITSI_URL    Jitsi deployment backing the :video tab.
;;                       Default http://localhost:9100.
