;; Copy to `config.local.edn` (gitignored) and edit.
;;
;; Everything here is OPTIONAL except `:alpha-users` — without at least one
;; account there is no way to log in, because simmis has no self-registration.
;;
;; Secrets belong in this file or in the environment, never in the repo.

{;; ---------------------------------------------------------------------------
 ;; Accounts. Seeded at boot; existing accounts are never modified, so changing
 ;; a password here does NOT change it in the database — delete the store or
 ;; change it in the UI.
 ;;
 ;; :role — :admin unlocks the admin panel (users, models, budgets). Anything
 ;; else is an ordinary member.
 :alpha-users
 [{:email "you@example.com"
   :name "Your Name"
   :handle "you"                ;; what @mentions resolve to; must be unique
   :password "change-me"
   :role :admin}]

 ;; ---------------------------------------------------------------------------
 ;; Telegram mirror (optional). A room can be mirrored into a Telegram chat;
 ;; messages flow both ways and agents answer in either place.
 ;;
 ;; The token can also come from TELEGRAM_BOT_TOKEN.
 ;; :allowed-users gates who may talk to the bot — numeric ids or "@handle".
 ;; An empty or missing allowlist refuses EVERY sender (dvergr authenticates a
 ;; Telegram sender only when the allowlist lists it). Numeric ids are safer:
 ;; a handle can be changed and then taken by someone else.
 #_:telegram #_{:token "123456:ABC-DEF..."
                :allowed-users #{123456789 "@your-handle"}}

 ;; ---------------------------------------------------------------------------
 ;; External identity providers (optional). Tokens from these issuers are
 ;; accepted alongside simmis's own, on the same socket — this is how WorkOS,
 ;; Clerk, Auth0 or Google sign-in attach. `:jwks-url` keys rotate and are
 ;; fetched on demand; `:public-key` pins a static one instead.
 ;; The provider must mint the web app's audience, `aud` = "simmis-api" (its
 ;; API identifier / resource indicator): a token for any other audience, or
 ;; none, is refused, whoever issued it.
 #_:oidc-issuers #_[{:iss "https://your-tenant.authkit.app"
                     :jwks-url "https://your-tenant.authkit.app/oauth2/jwks"
                     :alg :RS256}]

 ;; ---------------------------------------------------------------------------
 ;; Keys agents may USE (optional). An agent's sandbox never sees the host
 ;; environment: `env/get` resolves only what is granted here, so a key that is
 ;; set in the environment but not listed reads as unset — web search answers
 ;; "BRAVE_API_KEY … not set" although the server has it. A listed secret
 ;; reaches the agent as an opaque placeholder; the http egress swaps in the
 ;; real value only for `:allowed-domains`, in the listed locations.
 ;; `:env` names the variable the value comes from; `:config-path` points at a
 ;; value elsewhere in this file instead. Restart, or rejoin the agent, after
 ;; changing this.
 #_:secrets #_[{:name "BRAVE_API_KEY" :env "BRAVE_API_KEY"
                :allowed-domains ["https://api.search.brave.com"]
                :allowed-locations [:header :query]
                :header-names ["X-Subscription-Token"]}]

 ;; ---------------------------------------------------------------------------
 ;; Product default model (optional). Used only when nobody chose a model: an
 ;; agent with no override whose owner set no preference. Unset, it is the
 ;; Fireworks GLM family (accounts/fireworks/models/glm-*: the newest GLM the
 ;; account serves and dvergr registers). An exact id or a
 ;; family ("gpt-*-luna" = newest available). Read at every join, never stored
 ;; on an agent, so changing it and restarting moves every inheriting agent.
 ;; SIMMIS_DEFAULT_MODEL overrides this.
 ;;
 ;; The Codex subscription has no API key: run `codex login` AS THE USER RUNNING
 ;; SIMMIS (it writes ~/.codex/auth.json, or $CODEX_HOME/auth.json), then
 ;; restart. Without that login simmis warns once at boot, and inheriting
 ;; agents show "Credential required" with that instruction and do not join —
 ;; they never fall back to another model.
 ;;
 ;; :vision and :cheap point simmis's own one-shot calls at a model: :vision
 ;; describes shared screen frames, :cheap runs the chat summarizer and the
 ;; wiki merger. Unset, dvergr's default is used. An id or a family; a :vision
 ;; family resolves to its newest AVAILABLE version registered as
 ;; vision-capable (kimi-k3 is registered text-only, so "kimi-*" skips it).
 ;; A configured value that resolves to nothing warns once at boot, and those
 ;; calls then FAIL with the reason (a screen frame is stored as failed and
 ;; shows why) — they never use dvergr's default or another family instead.
 #_:models #_{:default "codex-subscription-luna-6"
              ;; Requires a real OpenAI API credential, not the Fireworks key.
              :vision  "gpt-5.4-mini"
              :cheap   "accounts/fireworks/models/minimax-*"}

 ;; ---------------------------------------------------------------------------
 ;; Storage GC (optional, OFF by default). Every 6h (and at boot) sweep the
 ;; orphaned Datahike index nodes of the system DB and every room's stores;
 ;; orphan-only, every branch head and its history is kept. OFF because a
 ;; failed mark on datahike without #1117 makes the sweep delete the whole
 ;; store — it wiped the dev.simm.is system DB. simmis pins datahike 0.8.1906,
 ;; which has #1117 (an incomplete mark refuses to sweep); on an older datahike
 ;; every sweep logs a warning. Back up before you turn it on. SIMMIS_STORAGE_GC=true|false overrides this.
 #_:storage-gc #_{:enabled? true}

 ;; ---------------------------------------------------------------------------
 ;; Mail sync (optional). At boot simmis starts IMAP sync for every mail account
 ;; stored in the system DB. ON by default; `false` leaves them unpolled (an
 ;; isolated or test instance). SIMMIS_MAIL_SYNC=true|false overrides this.
 ;; `:mail` is also where dvergr looks up mail accounts by id; `:sync?` sits
 ;; beside them.
 #_:mail #_{:sync? false}}

;; -----------------------------------------------------------------------------
;; Environment variables (NOT this file)
;;
;;   SIMMIS_JWT_SECRET   Signing secret for simmis's own tokens. Unset in
;;                       development: a secret is generated once and persisted
;;                       to .dvergr/jwt-secret so sessions survive restarts.
;;                       SET IT IN PRODUCTION — otherwise the secret lives in a
;;                       file next to the data it protects.
;;
;;   SIMMIS_DEV_AUTH     Set to "true" ONLY on a throwaway instance. It enables
;;                       POST /auth/dev, which mints a valid token for ANY email
;;                       and creates the account if missing. There is no password
;;                       check. simmis warns loudly on every boot while it is on.
;;
;;   SIMMIS_ALLOW_SELF_REGISTRATION
;;                       Set to "true" to enable POST /auth/register, which lets
;;                       anyone who can reach the server create an account. OFF by
;;                       default: accounts come from :alpha-users below, and an
;;                       account is what every :authenticated RPC checks for.
;;                       simmis warns on every boot while it is on.
;;
;;   FIREWORKS_API_KEY   LLM providers. A provider is registered at boot only
;;   OPENAI_API_KEY      if its key is present. The explicit default (only when
;;   ANTHROPIC_API_KEY   nobody chose a model) is the Fireworks GLM family unless
;;                       :models {:default ...} / SIMMIS_DEFAULT_MODEL says
;;                       otherwise, so FIREWORKS_API_KEY is the least-effort
;;                       option. A missing,
;;                       withdrawn, unsupported, or unreachable choice is never
;;                       replaced with that default. Set several; each agent
;;                       picks its own model, and the provider follows from it.
;;                       Keys are provider-scoped: OpenAI never supplies a
;;                       Fireworks credential, or vice versa. Restart after
;;                       adding or changing a provider credential. A key the
;;                       provider REJECTS reads as "Credential rejected" on the
;;                       affected rows: that is a key to replace, not an outage
;;                       to wait out.
;;
;;                       A key is permission to ASK, not the answer. Every one
;;                       of these providers is asked which models the ACCOUNT
;;                       may run, each over its own documented API — Anthropic
;;                       over its native paginated Models API, not an
;;                       OpenAI-compatible one. So a valid key whose account has
;;                       no access to a given model reads "Unavailable to
;;                       account" rather than offering a choice that would fail
;;                       at the first turn.
;;
;;   OPENAI_BASE_URL     Where OPENAI_API_KEY points. UNSET means OpenAI itself
;;                       (https://api.openai.com/v1) — the gpt-5.6 / gpt-5.5
;;                       models. Set it to reach any other OpenAI-compatible
;;                       endpoint, including a local one, with that same key.
;;                       It never changes Fireworks' base. A supplied base is
;;                       treated as compatible, not as native OpenAI behavior.
;;
;;   SIMMIS_JITSI_URL    Jitsi deployment backing the :video tab.
;;                       Default http://localhost:9100 — the development Jitsi,
;;                       i.e. every viewer's OWN machine. SET IT ON A SERVER:
;;                       without it calls go nowhere. A server run (-main) warns
;;                       at boot while it is unset.
;;
;;   SIMMIS_JITSI_JWT_SECRET
;;                       Shared secret with the Jitsi prosody (its
;;                       JWT_APP_SECRET), used to sign meeting tokens. Distinct
;;                       from SIMMIS_JWT_SECRET on purpose. Unset: generated once
;;                       into <DVERGR_HOME>/jitsi-jwt-secret, which the Jitsi
;;                       deployment must then be given. Set it on a server.
;;
;;   SIMMIS_CREDENTIAL_KEY
;;                       base64url-encoded 32-byte key encrypting stored mail
;;                       passwords. Unset: generated into
;;                       <DVERGR_HOME>/mail-credential-key. SET IT, AND KEEP IT,
;;                       on a server: a redeploy that loses that file leaves every
;;                       stored mail credential undecryptable (accounts must be
;;                       re-entered). Generate one with
;;                       `head -c32 /dev/urandom | basenc --base64url`.
;;
;;   SIMMIS_DEFAULT_MODEL
;;                       The product default model; overrides :models
;;                       {:default ...} above. E.g. codex-subscription-luna-6
;;                       (needs `codex login`, see above). Default
;;                       accounts/fireworks/models/glm-* (newest served GLM).
;;
;;   SIMMIS_STORAGE_GC   "true" turns the storage GC loop on, "false" off;
;;                       overrides :storage-gc above. Default off.
;;
;;   SIMMIS_MAIL_SYNC    "false" stops boot from starting IMAP sync; overrides
;;                       :mail {:sync? ...} above. Default on.
;;
;;   SIMMIS_TRANSCRIPTS_DIR
;;                       Directory the jigasi transcriber saves finished call
;;                       transcripts into (JIGASI_TRANSCRIBER_ENABLE_SAVING=1;
;;                       the docker compose mounts ${CONFIG}/transcripts). Set,
;;                       boot watches it and posts each NEW file into its room
;;                       (the meeting name is the room id) as a drive file under
;;                       transcripts/ plus a message. Unset, no watcher.
;;
;;   GROQ_API_KEY        Speech-to-text for "Transcribe" on an audio file and
;;                       telegram voice notes (dvergr.audio.stt): Groq whisper
;;                       when set, else OpenAI whisper with a real (non-fw_)
;;                       OPENAI_API_KEY, else local faster-whisper
;;                       (`pip install faster-whisper`; scripts/transcribe.py,
;;                       DVERGR_WHISPER_MODEL picks the size, default "base").
;;                       Audio over 20 MB is cut into 10-minute pieces with
;;                       ffmpeg first, so long recordings need ffmpeg.
;;
;; Running a SECOND instance on the same machine (an agent's end-to-end run next
;; to your demo). Unset, each of these is the default instance's value.
;;
;;   SIMMIS_PORT_OFFSET  Added to every dev port: nREPL 47888, shadow nREPL
;;                       9631, shadow's own server 9630, the page 8080, the
;;                       websocket 47295. One offset rather than one variable per
;;                       port, because the page, shadow's proxy and the websocket
;;                       URL compiled into the client only work as a set. An
;;                       offset instance never starts Telegram (a bot token can
;;                       have one poller) and names its blob cookie
;;                       simmis_blob_<offset> (cookies are not port-scoped).
;;   DVERGR_HOME         State home: system DB, room stores, generated secrets
;;                       (jwt-secret, jitsi-jwt-secret, mail-credential-key).
;;                       Default ./.dvergr. dvergr's own variable.
;;   SIMMIS_DATA_DIR     simmis's stores (simmis-v2, KBs, blobs, drives, ...).
;;                       Default ./data.
;;   DVERGR_CONFIG       This file's path instead of ./config.local.edn.
;;
;;   Use offset 1000 or 3000, not 2000: that puts the page on 10080, which
;;   browsers refuse (ERR_UNSAFE_PORT). On a test instance also set
;;   SIMMIS_MAIL_SYNC=false, and keep it off the machine's LLM credentials —
;;   CLAUDE.md "Running a second instance" has the full command.
;;
;; Point DVERGR_HOME and SIMMIS_DATA_DIR at a fresh directory, not a copy of
;; another instance's: a copy carries the same store ids.
